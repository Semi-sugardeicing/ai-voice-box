const int ZH_NUM = sizeof(ZH_TABLE) / sizeof(ZH_TABLE[0]);


/* 在 (x,y) 画一个 16x16 汉字，找不到返回 false */
bool drawZhAt(const char* ch, int x, int y) {
  for (int i = 0; i < ZH_NUM; i++) {
    if (strcmp(ZH_TABLE[i].ch, ch) == 0) {
      for (int r = 0; r < 16; r++) {
        uint8_t hi = ZH_TABLE[i].bmp[r * 2];
        uint8_t lo = ZH_TABLE[i].bmp[r * 2 + 1];
        for (int c = 0; c < 8; c++) {
          if (hi & (0x80 >> c)) display.drawPixel(x + c, y + r, SSD1306_WHITE);
          if (lo & (0x80 >> c)) display.drawPixel(x + 8 + c, y + r, SSD1306_WHITE);
        }
      }
      return true;
    }
  }
  return false;
}

/* 画一串 UTF-8 汉字（只支持表里有的），返回占用宽度 */
int drawZhString(const char* s, int x, int y) {
  int cx = x;
  const unsigned char* p = (const unsigned char*)s;
  while (*p) {
    char one[5] = {0, 0, 0, 0, 0};
    int n = 1;
    if (*p < 0x80) n = 1;
    else if ((*p & 0xE0) == 0xC0) n = 2;
    else if ((*p & 0xF0) == 0xE0) n = 3;
    else if ((*p & 0xF8) == 0xF0) n = 4;
    for (int i = 0; i < n; i++) one[i] = (char)p[i];
    if (n == 1) {
      display.setTextSize(1);
      display.setTextColor(SSD1306_WHITE);
      display.setCursor(cx, y + 4);
      display.print(one);
      cx += 6;
    } else {
      drawZhAt(one, cx, y);
      cx += 16;
    }
    p += n;
    if (cx > SCR_W - 8) break;
  }
  return cx - x;
}

/* ==================== 屏幕 ==================== */
void drawWifiBar(int rssi) {
  if (!screenOK) return;
  int lv = 0;
  if (rssi > -55)      lv = 4;
  else if (rssi > -65) lv = 3;
  else if (rssi > -75) lv = 2;
  else if (rssi > -85) lv = 1;
  for (int i = 0; i < 4; i++) {
    int h = 2 + i * 2;
    int x = 2 + i * 3;
    int y = 9 - h;
    if (i < lv) display.fillRect(x, y, 2, h, SSD1306_WHITE);
    else        display.drawRect(x, y, 2, h, SSD1306_WHITE);
  }
}

void drawScreen() {
  if (!screenOK) return;
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  /* 顶栏 */
  if (cfgMode) {
    display.setCursor(14, 0); display.print("SETUP MODE");
  } else if (wifiReady) {
    drawWifiBar(WiFi.RSSI());           /* x=2..13 */
    display.setCursor(20, 0);
    display.printf("%2d/%d", curSt + 1, totalStations());   /* 台号 20..~48 */
    display.setCursor(56, 0);
    display.printf("V%d", vol);                    /* 音量 56..~70 */
    /* 电量占位/时间留白 */
  } else {
    display.setCursor(14, 0); display.print("NO WIFI");
  }
  display.drawLine(0, 10, SCR_W - 1, 10, SSD1306_WHITE);

  /* 台名：16x16 点阵，居中 */
  {
    const char* nmc = "";
    const char* urlc = "";
    String nb, ub;
    getStation(curSt, nmc, urlc, nb, ub);
    const char* nm = nmc;
    int len = 0;
    for (const unsigned char* q = (const unsigned char*)nm; *q; ) {
      if (*q < 0x80) { q += 1; len += 1; }
      else if ((*q & 0xE0) == 0xC0) { q += 2; len += 1; }
      else if ((*q & 0xF0) == 0xE0) { q += 3; len += 1; }
      else { q += 4; len += 1; }
    }
    int w = len * 16;
    int x0 = (SCR_W - w) / 2;
    if (x0 < 0) x0 = 0;
    drawZhString(nm, x0, 14);
  }

  display.setTextSize(1);
  display.setCursor(0, 34);
  if (vol == 0)        display.print("|| MUTED   K3=vol+");
  else if (!audio.isRunning() && playing) display.print("reconnecting...");
  else if (!wifiReady) display.print("connecting wifi...");
  else                 display.print(stLine1.c_str());

  display.setCursor(0, 44);
  display.print(stLine2.c_str());

  /* 音量条：放在状态文字下方、屏幕底部线之上 */
  {
    int pct = (int)((uint32_t)vol * 100 / VOL_MAX);
    if (pct > 100) pct = 100;
    display.drawRect(0, 54, SCR_W, 9, SSD1306_WHITE);
    for (int k = 1; k < 5; k++) display.drawPixel(k * SCR_W / 5, 57, SSD1306_WHITE);
    if (pct > 0) display.fillRect(1, 55, (SCR_W - 2) * pct / 100, 7, SSD1306_WHITE);
  }

  display.display();
}

/* ==================== 电台 ==================== */
void startStation(int idx) {
  int total = totalStations();
  if (idx < 0)       idx = total - 1;
  if (idx >= total)  idx = 0;
  curSt = idx;

  audio.stopSong();
  playing = false;
  stLine1 = "connecting...";
  stLine2 = "";
  drawScreen();

  const char* nm = "";
  const char* url = "";
  String nmBuf, urlBuf;
  getStation(curSt, nm, url, nmBuf, urlBuf);

  Serial.printf("[ST] %d/%d %s\n     %s\n", curSt + 1, total, nm, url);
  bool ok = audio.connecttohost(url);
  if (ok) {
    playing = true;
    audio.setVolume(vol);
    mutedByUser = (vol == 0);
    stLine1 = "buffering...";
  } else {
    stLine1 = "CONNECT FAIL";
    stLine2 = "K3 = retry";
  }
  drawScreen();
}


/* ===== V5: 常驻热点 + 网页配置（5 个 WiFi + 自定义电台） ==================
   设计：
     - 开机就开热点 Radio-Setup / 12345678，同时照常连家里 WiFi（AP+STA 并存）
     - 手机连上热点 → 192.168.4.1 → 能配：
         ① 5 组 WiFi 名/密码（存 NVS，优先级高于固件里写死的）
         ② 自定义电台（名字 + 地址，最多 16 个，存 NVS）
     - 热点可以 K4 长按关掉（省电），再长按开回来
   注意：热点开着会多吃一点功耗，但 S3 撑得住。
   ========================================================================= */

#define AP_WIFI_MAX   5    /* 可存 5 组 WiFi */
#define AP_ST_MAX     16   /* 可加 16 个自定义电台 */

struct SavedWifi { String ssid; String pass; };
SavedWifi sWifi[AP_WIFI_MAX];
int       sWifiNum = 0;

struct SavedSt { String name; String url; };
SavedSt   sSt[AP_ST_MAX];
int       sStNum = 0;

/* ---- NVS 读写 ---- */
void loadNvs() {
  prefs.begin("radio", true);
  sWifiNum = prefs.getInt("wn", 0);
  if (sWifiNum > AP_WIFI_MAX) sWifiNum = AP_WIFI_MAX;
  for (int i = 0; i < sWifiNum; i++) {
    sWifi[i].ssid = prefs.getString((String("ws") + i).c_str(), "");
    sWifi[i].pass = prefs.getString((String("wp") + i).c_str(), "");
  }
  sStNum = prefs.getInt("sn", 0);
  if (sStNum > AP_ST_MAX) sStNum = AP_ST_MAX;
  for (int i = 0; i < sStNum; i++) {
    sSt[i].name = prefs.getString((String("n") + i).c_str(), "");
    sSt[i].url  = prefs.getString((String("u") + i).c_str(), "");
  }
  prefs.end();

  Serial.printf("[NVS] wifi=%d  stations=%d\n", sWifiNum, sStNum);
  for (int i = 0; i < sWifiNum; i++) Serial.printf("   wifi %d: %s\n", i + 1, sWifi[i].ssid.c_str());
  for (int i = 0; i < sStNum;  i++) Serial.printf("   st   %d: %s %s\n", i + 1, sSt[i].name.c_str(), sSt[i].url.c_str());
}

void saveAllNvs() {
  prefs.begin("radio", false);
  prefs.putInt("wn", sWifiNum);
  for (int i = 0; i < sWifiNum; i++) {
    prefs.putString((String("ws") + i).c_str(), sWifi[i].ssid);
    prefs.putString((String("wp") + i).c_str(), sWifi[i].pass);
  }
  /* 清掉多余的旧记录 */
  for (int i = sWifiNum; i < AP_WIFI_MAX; i++) {
    prefs.remove((String("ws") + i).c_str());
    prefs.remove((String("wp") + i).c_str());
  }
  prefs.putInt("sn", sStNum);
  for (int i = 0; i < sStNum; i++) {
    prefs.putString((String("n") + i).c_str(), sSt[i].name);
    prefs.putString((String("u") + i).c_str(), sSt[i].url);
  }
  for (int i = sStNum; i < AP_ST_MAX; i++) {
    prefs.remove((String("n") + i).c_str());
    prefs.remove((String("u") + i).c_str());
  }
  prefs.end();
}

/* ---- 网页 ---- */
void htmlHead(String& h, const char* title) {
  h += F("<!doctype html><meta charset=utf-8>");
  h += F("<meta name=viewport content='width=device-width,initial-scale=1'>");
  h += F("<title>"); h += title; h += F("</title>");
  h += F("<style>body{font:15px/1.6 -apple-system,sans-serif;padding:16px;max-width:520px;margin:auto;background:#fafafa}");
  h += F("h2{font-size:19px;margin:18px 0 8px;color:#222}h3{font-size:16px;margin:14px 0 6px}");
  h += F("input{width:100%;padding:9px;margin:4px 0;border:1px solid #ccc;border-radius:6px;box-sizing:border-box;font-size:15px}");
  h += F("button{padding:10px 22px;font-size:15px;border:0;border-radius:6px;background:#2b7de9;color:#fff;margin:6px 4px 6px 0}");
  h += F("button.del{background:#e95b5b}.row{background:#fff;border:1px solid #e5e5e5;border-radius:8px;padding:10px;margin:8px 0}");
  h += F(".hint{color:#888;font-size:13px}.ok{color:#0a0;font-weight:600}</style>");
}

void buildCfgHtml() {
  String h;
  h.reserve(6000);
  htmlHead(h, "收音机设置");
  h += F("<h2>📻 收音机设置</h2>");
  h += F("<p class=hint>热点 <b>Radio-Setup</b> / 密码 <b>12345678</b><br>地址 <b>192.168.4.1</b></p>");

  /* ---- WiFi ---- */
  h += F("<h3>WiFi 列表（最多 5 个）</h3>");
  h += F("<p class=hint>按顺序尝试，连上哪个用哪个。家里 2.4G 优先（ESP32-S3 不支持 5G）</p>");
  for (int i = 0; i < sWifiNum; i++) {
    h += F("<div class=row><form method=POST action=/savewifi>");
    h += F("<input type=hidden name=i value="); h += i; h += F(">");
    h += F("<input name=ssid placeholder='WiFi 名' value='"); h += sWifi[i].ssid; h += F("'>");
    h += F("<input name=pass placeholder='密码' value='"); h += sWifi[i].pass; h += F("'>");
    h += F("<button>保存</button><button class=del name=del value=1>删除</button></form></div>");
  }
  if (sWifiNum < AP_WIFI_MAX) {
    h += F("<div class=row><form method=POST action=/savewifi>");
    h += F("<input name=ssid placeholder='新 WiFi 名'>");
    h += F("<input name=pass placeholder='密码'>");
    h += F("<button>添加</button></form></div>");
  }

  /* ---- 电台 ---- */
  h += F("<h3>自定义电台（最多 16 个）</h3>");
  h += F("<p class=hint>地址要能直连的音频流（.mp3 / .aac / .m3u8），不能是网页</p>");
  for (int i = 0; i < sStNum; i++) {
    h += F("<div class=row><form method=POST action=/savest>");
    h += F("<input type=hidden name=i value="); h += i; h += F(">");
    h += F("<input name=name placeholder='台名（8 字内）' value='"); h += sSt[i].name; h += F("'>");
    h += F("<input name=url placeholder='音频地址' value='"); h += sSt[i].url; h += F("'>");
    h += F("<button>保存</button><button class=del name=del value=1>删除</button></form></div>");
  }
  if (sStNum < AP_ST_MAX) {
    h += F("<div class=row><form method=POST action=/savest>");
    h += F("<input name=name placeholder='新台名'>");
    h += F("<input name=url placeholder='https://.../xxx.mp3'>");
    h += F("<button>添加</button></form></div>");
  }

  h += F("<p class=hint>内置 20 个央广/地方台不变，自定义的追加在后面。</p>");
  h += F("<p><a href=/restart><button>重启盒子</button></a></p>");

  cfgServer.sendHeader("Content-Type", "text/html; charset=utf-8");
  cfgServer.sendHeader("Content-Length", String(h.length()));
  cfgServer.send(200, "text/html", "");
  cfgServer.sendContent(h);
}

void sendMsg(const char* msg) {
  String h;
  h.reserve(400);
  htmlHead(h, "OK");
  h += F("<p class=ok>"); h += msg; h += F("</p>");
  h += F("<p><a href=/><button>返回</button></a></p>");
  cfgServer.sendHeader("Content-Type", "text/html; charset=utf-8");
  cfgServer.sendHeader("Content-Length", String(h.length()));
  cfgServer.send(200, "text/html", "");
  cfgServer.sendContent(h);
}

void setupWeb() {
  cfgServer.on("/", []() { buildCfgHtml(); });

  cfgServer.on("/savewifi", []() {
    int i = cfgServer.arg("i").toInt();
    String ssid = cfgServer.arg("ssid");
    String pass = cfgServer.arg("pass");
    bool del = cfgServer.hasArg("del");

    if (cfgServer.hasArg("i")) {           /* 改已有 */
      if (i >= 0 && i < sWifiNum) {
        if (del) {
          for (int k = i; k < sWifiNum - 1; k++) sWifi[k] = sWifi[k + 1];
          sWifiNum--;
        } else if (ssid.length()) {
          sWifi[i].ssid = ssid;
          sWifi[i].pass = pass;
        }
      }
    } else if (ssid.length() && sWifiNum < AP_WIFI_MAX) {   /* 新增 */
      sWifi[sWifiNum].ssid = ssid;
      sWifi[sWifiNum].pass = pass;
      sWifiNum++;
    }
    saveAllNvs();
    sendMsg("WiFi 已保存");
  });

  cfgServer.on("/savest", []() {
    int i = cfgServer.arg("i").toInt();
    String nm = cfgServer.arg("name");
    String u  = cfgServer.arg("url");
    bool del = cfgServer.hasArg("del");

    if (cfgServer.hasArg("i")) {
      if (i >= 0 && i < sStNum) {
        if (del) {
          for (int k = i; k < sStNum - 1; k++) sSt[k] = sSt[k + 1];
          sStNum--;
        } else if (nm.length() && u.length()) {
          sSt[i].name = nm;
          sSt[i].url  = u;
        }
      }
    } else if (nm.length() && u.length() && sStNum < AP_ST_MAX) {
      sSt[sStNum].name = nm;
      sSt[sStNum].url  = u;
      sStNum++;
    }
    saveAllNvs();
    sendMsg("电台已保存（重启后生效）");
  });

  cfgServer.on("/restart", []() {
    sendMsg("正在重启…");
    delay(800);
    ESP.restart();
  });

  cfgServer.onNotFound([]() { buildCfgHtml(); });
  cfgServer.begin();
}

/* ---- 开/关热点 ---- */
bool apOn = false;
void startAp() {
  if (apOn) return;
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(AP_SSID, AP_PASS);
  dnsServer.start(53, "*", WiFi.softAPIP());
  setupWeb();
  apOn = true;
  Serial.printf("[AP] on  %s / %s  -> http://%d.%d.%d.%d\n", AP_SSID, AP_PASS,
                WiFi.softAPIP()[0], WiFi.softAPIP()[1], WiFi.softAPIP()[2], WiFi.softAPIP()[3]);
}

void stopAp() {
  if (!apOn) return;
  dnsServer.stop();
  WiFi.softAPdisconnect(true);
  WiFi.mode(WIFI_STA);
  apOn = false;
  Serial.println("[AP] off");
}

/* ---- 自定义电台追加到总表 ---- */
/* 总表 = 内置 STATIONS + NVS 里的 sSt，用一个函数取 */
int totalStations() { return ST_NUM + sStNum; }

void getStation(int idx, const char*& nm, const char*& url, String& nmBuf, String& urlBuf) {
  if (idx < ST_NUM) {
    nm = STATIONS[idx].name;
    url = STATIONS[idx].url;
  } else {
    int k = idx - ST_NUM;
    if (k < 0) k = 0;
    if (k >= sStNum) k = sStNum - 1;
    nmBuf = sSt[k].name;
    urlBuf = sSt[k].url;
    nm = nmBuf.c_str();
    url = urlBuf.c_str();
  }
}

void connectWifi() {
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);

  /* 优先级：网页存的 5 组 > 固件里写死的 */
  for (int i = 0; i < sWifiNum; i++) {
    if (sWifi[i].ssid.length()) wifiMulti.addAP(sWifi[i].ssid.c_str(), sWifi[i].pass.c_str());
  }
  for (int i = 0; i < WIFI_NUM; i++) wifiMulti.addAP(WIFI_LIST[i].ssid, WIFI_LIST[i].pass);

  if (screenOK) {
    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(0, 0); display.print("WiFi...");
    display.setCursor(0, 16); display.print(WIFI_LIST[0].ssid);
    display.display();
  }

  if (wifiMulti.run(15000) == WL_CONNECTED) {
    wifiReady = true;
    IPAddress ip = WiFi.localIP();
    Serial.printf("[WIFI] ok: %s  %u.%u.%u.%u  rssi=%d\n",
                  WiFi.SSID().c_str(), ip[0], ip[1], ip[2], ip[3], WiFi.RSSI());
    return;
  }
  Serial.println("[WIFI] FAILED — still running, join hotspot Radio-Setup to configure");
}

