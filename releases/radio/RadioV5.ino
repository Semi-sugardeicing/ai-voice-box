/* ==================== 按键 ==================== */
struct KeyBtn { uint8_t pin; bool stable; bool lastRead; unsigned long tMs; bool fired; };
KeyBtn bPrev = { BTN_PREV, HIGH, HIGH, 0, false };
KeyBtn bNext = { BTN_NEXT, HIGH, HIGH, 0, false };
KeyBtn bOk   = { BTN_OK,   HIGH, HIGH, 0, false };
KeyBtn bStop = { BTN_STOP, HIGH, HIGH, 0, false };

bool keyPressed(KeyBtn& kb) {
  bool rd = digitalRead(kb.pin);
  unsigned long now = millis();
  if (rd != kb.lastRead) { kb.lastRead = rd; kb.tMs = now; }
  if (now - kb.tMs < 25) return false;            /* 25ms 消抖 */
  if (rd != kb.stable) {
    kb.stable = rd;
    if (rd == LOW && !kb.fired) { kb.fired = true; return true; }
    if (rd == HIGH) kb.fired = false;
  }
  return false;
}

/* 音量加减：满档 21，减到 0 = 静音 */
void volUp() {
  uint8_t nv = vol + VOL_STEP;
  if (nv > VOL_MAX) nv = VOL_MAX;
  if (nv == vol) return;
  vol = nv;
  if (mutedByUser) mutedByUser = false;
  audio.setVolume(vol);
  Serial.printf("[VOL] %d\n", vol);
  drawScreen();
}

void volDown() {
  if (vol <= VOL_STEP) vol = 0;
  else                 vol -= VOL_STEP;
  if (vol == 0) mutedByUser = true;
  else          mutedByUser = false;
  audio.setVolume(vol);
  Serial.printf("[VOL] %d\n", vol);
  drawScreen();
}

void handleKeys() {
  bool cool = (millis() - lastStChange) > SWITCH_COOLDOWN_MS;
  if (keyPressed(bPrev) && cool) { Serial.println("[K1] prev"); lastStChange = millis(); startStation(curSt - 1); }
  if (keyPressed(bNext) && cool) { Serial.println("[K2] next"); lastStChange = millis(); startStation(curSt + 1); }
  /* v2.1: 音量键 —— 按下立刻走一格，之后按住每 150ms 一格，零等待 */
  static unsigned long okNext = 0, stopNext = 0;
  static bool okHeld = false, stopHeld = false;
  unsigned long now = millis();

  if (digitalRead(BTN_OK) == LOW) {
    if (!okHeld) { volUp(); okHeld = true; okNext = now + 350; }        /* 第一下立刻 */
    else if (now > okNext) { volUp(); okNext = now + 150; }             /* 之后 150ms 一格 */
  } else { okHeld = false; }

  if (digitalRead(BTN_STOP) == LOW) {
    if (!stopHeld) { volDown(); stopHeld = true; stopNext = now + 350; }
    else if (now > stopNext) { volDown(); stopNext = now + 150; }
  } else { stopHeld = false; }
}


