const int ZH_NUM = sizeof(ZH_TABLE) / sizeof(ZH_TABLE[0]);


/* 在 (x,y) 画一个 16x16 汉字，找不到返回 false */
bool drawZhAt(const char* ch, int x, int y) {
  for (int i = 0; i < ZH_NUM; i++) {
    if (strcmp(ZH_TABLE[i].ch, ch) == 0) {
      for (int r = 0; r < 16; r++) {
        uint8_t hi = ZH_TABLE[i].bmp[r * 2];
        uint8_t lo = ZH_TABLE[i].bmp[r * 2 + 1];
        for (int c = 0; c < 8; c++) {
          if (hi & (0x80 >> c)) display.drawPixel(x + c, y + r, SSD1306_WHITE);
          if (lo & (0x80 >> c)) display.drawPixel(x + 8 + c, y + r, SSD1306_WHITE);
        }
      }
      return true;
    }
  }
  return false;
}

/* 画一串 UTF-8 汉字（只支持表里有的），返回占用宽度 */
int drawZhString(const char* s, int x, int y) {
  int cx = x;
  const unsigned char* p = (const unsigned char*)s;
  while (*p) {
    char one[5] = {0, 0, 0, 0, 0};
    int n = 1;
    if (*p < 0x80) n = 1;
    else if ((*p & 0xE0) == 0xC0) n = 2;
    else if ((*p & 0xF0) == 0xE0) n = 3;
    else if ((*p & 0xF8) == 0xF0) n = 4;
    for (int i = 0; i < n; i++) one[i] = (char)p[i];
    if (n == 1) {
      display.setTextSize(1);
      display.setTextColor(SSD1306_WHITE);
      display.setCursor(cx, y + 4);
      display.print(one);
      cx += 6;
    } else {
      drawZhAt(one, cx, y);
      cx += 16;
    }
    p += n;
    if (cx > SCR_W - 8) break;
  }
  return cx - x;
}

/* ==================== 屏幕 ==================== */
void drawWifiBar(int rssi) {
  if (!screenOK) return;
  int lv = 0;
  if (rssi > -55)      lv = 4;
  else if (rssi > -65) lv = 3;
  else if (rssi > -75) lv = 2;
  else if (rssi > -85) lv = 1;
  for (int i = 0; i < 4; i++) {
    int h = 2 + i * 2;
    int x = 2 + i * 3;
    int y = 9 - h;
    if (i < lv) display.fillRect(x, y, 2, h, SSD1306_WHITE);
    else        display.drawRect(x, y, 2, h, SSD1306_WHITE);
  }
}

void drawScreen() {
  if (!screenOK) return;
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  /* 顶栏 */
  if (cfgMode) {
    display.setCursor(14, 0); display.print("SETUP MODE");
  } else if (wifiReady) {
    drawWifiBar(WiFi.RSSI());
    display.setCursor(78, 0);
    display.printf("%d/%d", curSt + 1, ST_NUM);
    display.setCursor(106, 0);
    display.printf("VOL%d", vol);
  } else {
    display.setCursor(14, 0); display.print("NO WIFI");
  }
  display.drawLine(0, 10, SCR_W - 1, 10, SSD1306_WHITE);

  /* 台名：16x16 点阵，居中 */
  {
    const char* nm = STATIONS[curSt].name;
    int len = 0;
    for (const unsigned char* q = (const unsigned char*)nm; *q; ) {
      if (*q < 0x80) { q += 1; len += 1; }
      else if ((*q & 0xE0) == 0xC0) { q += 2; len += 1; }
      else if ((*q & 0xF0) == 0xE0) { q += 3; len += 1; }
      else { q += 4; len += 1; }
    }
    int w = len * 16;
    int x0 = (SCR_W - w) / 2;
    if (x0 < 0) x0 = 0;
    drawZhString(nm, x0, 14);
  }

  display.setTextSize(1);
  display.setCursor(0, 34);
  if (vol == 0)        display.print("|| MUTED   K3=vol+");
  else if (!audio.isRunning() && playing) display.print("reconnecting...");
  else if (!wifiReady) display.print("connecting wifi...");
  else                 display.print(stLine1.c_str());

  display.setCursor(0, 44);
  display.print(stLine2.c_str());

  /* 底部：音量条（0..21 换算成百分比） */
  {
    int pct = (int)((uint32_t)vol * 100 / VOL_MAX);
    if (pct > 100) pct = 100;
    display.drawRect(0, 54, SCR_W, 8, SSD1306_WHITE);
    /* 刻度：每 4 格一个分隔，方便目测 */
    for (int k = 1; k < 5; k++) display.drawPixel(k * SCR_W / 5, 56, SSD1306_WHITE);
    if (pct > 0) display.fillRect(1, 55, (SCR_W - 2) * pct / 100, 6, SSD1306_WHITE);
  }

  display.display();
}

/* ==================== 电台 ==================== */
void startStation(int idx) {
  if (idx < 0)       idx = ST_NUM - 1;
  if (idx >= ST_NUM) idx = 0;
  curSt = idx;

  audio.stopSong();
  playing = false;
  stLine1 = "connecting...";
  stLine2 = "";
  drawScreen();

  Serial.printf("[ST] %d %s\n     %s\n", curSt, STATIONS[curSt].name, STATIONS[curSt].url);
  bool ok = audio.connecttohost(STATIONS[curSt].url);
  if (ok) {
    playing = true;
    audio.setVolume(vol);
    mutedByUser = (vol == 0);
    stLine1 = "buffering...";
  } else {
    stLine1 = "CONNECT FAIL";
    stLine2 = "K3 = retry";
  }
  drawScreen();
}


/* ==================== 配网（家里 WiFi 连不上时） ==================== */
void buildCfgHtml() {
  String h;
  h.reserve(1400);
  h += F("<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'>");
  h += F("<title>Radio Setup</title><body style='font:16px sans-serif;padding:18px;max-width:420px;margin:auto'>");
  h += F("<h2>收音机配网</h2>");
  h += F("<form method=POST action=/save>");
  h += F("<p>WiFi 名<br><input name=ssid style='width:100%;padding:8px' value='");
  h += WiFi.SSID();
  h += F("'></p><p>密码<br><input name=pass style='width:100%;padding:8px' value=''></p>");
  h += F("<p><button style='padding:10px 24px;font-size:16px'>保存并连接</button></p></form>");
  h += F("<p style='color:#666;font-size:13px'>保存后板子会自动重启连接。密码只存在板子里。</p>");
  h += F("<hr><p>出厂预置：<br>");
  for (int i = 0; i < WIFI_NUM; i++) h += String(i + 1) + ". " + WIFI_LIST[i].ssid + "<br>";
  h += F("</p></body>");

  cfgServer.sendHeader("Content-Type", "text/html; charset=utf-8");
  cfgServer.sendHeader("Content-Length", String(h.length()));
  cfgServer.send(200, "text/html", "");
  cfgServer.sendContent(h);
}

void runCfgPortal() {
  cfgMode = true;
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(AP_SSID, AP_PASS);
  dnsServer.start(53, "*", WiFi.softAPIP());

  cfgServer.on("/", []() { buildCfgHtml(); });
  cfgServer.on("/save", []() {
    String s = cfgServer.arg("ssid");
    String p = cfgServer.arg("pass");
    if (s.length()) {
      prefs.begin("radio", false);
      prefs.putString("ssid", s);
      prefs.putString("pass", p);
      prefs.end();
      cfgServer.send(200, "text/html; charset=utf-8", "<meta charset=utf-8><h3>已保存，正在重启…</h3>");
      delay(1200);
      ESP.restart();
    } else {
      cfgServer.send(200, "text/html; charset=utf-8", "<meta charset=utf-8><h3>没填名字</h3>");
    }
  });
  cfgServer.onNotFound([]() { buildCfgHtml(); });
  cfgServer.begin();

  Serial.printf("[AP] %s / %s -> http://192.168.4.1\n", AP_SSID, AP_PASS);

  while (true) {
    dnsServer.processNextRequest();
    cfgServer.handleClient();
    if (screenOK) {
      display.clearDisplay();
      display.setTextColor(SSD1306_WHITE);
      display.setTextSize(1);
      display.setCursor(0, 0);  display.print("WIFI SETUP");
      display.setCursor(0, 18); display.print("1. join:");
      display.setTextSize(2);
      display.setCursor(0, 28); display.print(AP_SSID);
      display.setTextSize(1);
      display.setCursor(0, 50); display.print("2. open 192.168.4.1");
      display.display();
    }
    delay(2);
  }
}

void connectWifi() {
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);

  prefs.begin("radio", true);
  String s = prefs.getString("ssid", "");
  String p = prefs.getString("pass", "");
  prefs.end();

  if (s.length()) {
    Serial.printf("[WIFI] nvs: %s\n", s.c_str());
    wifiMulti.addAP(s.c_str(), p.c_str());
  }
  for (int i = 0; i < WIFI_NUM; i++) wifiMulti.addAP(WIFI_LIST[i].ssid, WIFI_LIST[i].pass);

  if (screenOK) {
    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(0, 0); display.print("WiFi...");
    display.setCursor(0, 16); display.print(WIFI_LIST[0].ssid);
    display.display();
  }

  if (wifiMulti.run(15000) == WL_CONNECTED) {
    wifiReady = true;
    IPAddress ip = WiFi.localIP();
    Serial.printf("[WIFI] ok: %s  %u.%u.%u.%u  rssi=%d\n",
                  WiFi.SSID().c_str(), ip[0], ip[1], ip[2], ip[3], WiFi.RSSI());
    return;
  }
  Serial.println("[WIFI] FAILED -> config portal");
  runCfgPortal();      /* 不返回 */
}

